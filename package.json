  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "@types/react":              "^18.3.12",
    "@types/react-dom":          "^18.3.1",
    "@vitejs/plugin-react":      "^4.3.3",
    "terser":                    "^5.36.0",
    "typescript":                "^5.6.3",
    "vite":                      "^6.0.1",
    "wrangler":                  "^3.99.0"
  }
}
